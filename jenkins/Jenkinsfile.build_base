pipeline {
    agent any

    environment {
        IMAGE_NAME = "counter_base"
        REGISTRY   = "localhost:5000"
        REGISTRY_USER = "testuser"
        REGISTRY_PASSWORD = "testpassword"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Determine SHA') {
            steps {
                script {
                    SHORT_SHA = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    IMAGE_TAG = SHORT_SHA
                    echo "Current commit short SHA: ${SHORT_SHA}"
                }
            }
        }

        stage('Check Registry') {
            steps {
                script {
                    def result = sh(
                        script: "docker pull ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} >/dev/null 2>&1 || echo 'notfound'",
                        returnStdout: true
                    ).trim()
                    
                    env.BUILD_IMAGE = (result == "notfound") ? "true" : "false"
                    echo "BUILD_IMAGE=${env.BUILD_IMAGE}"
                }
            }
        }

        stage('Build Base Image') {
            when {
                expression { env.BUILD_IMAGE == "true" }
            }
            steps {
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f Dockerfile.base ."
            }
        }

        stage('Login to Registry') {
            when {
                expression { env.BUILD_IMAGE == "true" }
            }
            steps {
                sh "echo ${REGISTRY_PASSWORD} | docker login ${REGISTRY} -u ${REGISTRY_USER} --password-stdin"
            }
        }

        stage('Push Image to Registry') {
            when {
                expression { env.BUILD_IMAGE == "true" }
            }
            steps {
                sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
                sh "docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }
    }

    post {
        always {
            echo "Cleanup local images..."
            sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
            sh "docker rmi ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
    }
}
