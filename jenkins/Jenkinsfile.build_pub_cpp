pipeline {
    agent any
    environment {
        IMAGE_NAME = "localhost:5000/counter_publisher_cpp"
        BASE_IMAGE = "counter_base:latest"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Get Git SHA') {
            steps {
                script {
                    SHORT_SHA = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    IMAGE_TAG = "${SHORT_SHA}"
                    echo "Git SHA: ${SHORT_SHA}"
                }
            }
        }
        stage('Check if image exists') {
            steps {
                script {
                    def exists = sh(script: "docker pull ${IMAGE_NAME}:${IMAGE_TAG} || echo notfound", returnStdout: true).trim()
                    if (exists != "notfound") {
                        echo "Image already exists, skipping build."
                        currentBuild.result = 'SUCCESS'
                        return
                    } else {
                        echo "Image not found in registry, will build."
                    }
                }
            }
        }
        stage('Build Image') {
			steps {
				sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f counter_publisher_cpp/Dockerfile.cpp_pub ."
			}
		}
        stage('Login to Registry') {
            steps {
                script {
                    sh "echo testpassword | docker login localhost:5000 -u testuser --password-stdin"
                }
            }
        }
        stage('Push Image') {
            steps {
                script {
                    sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }
    }
    post {
        always {
            echo "Cleanup local images..."
            sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
    }
}
